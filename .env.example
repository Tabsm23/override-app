VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase (client)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_AUTH_REDIRECT_URL=http://localhost:5178
CHECKOUT_BASE_URL=http://localhost:5178

# Stripe (client — publishable key and price ID for Checkout)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_STRIPE_PRICE_ID=price_...

# Stripe + Supabase (server only — never expose in the browser)
STRIPE_SECRET_KEY=sk_test_...
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App base URL used for password reset redirects (client + server)
# Prefer setting BOTH so browser + server agree in dev/prod.
CHECKOUT_BASE_URL=http://localhost:5178
VITE_CHECKOUT_BASE_URL=http://localhost:5178
